# Varuna Netra backend configuration template
# Copy this file to backend/.env for local development.
# Never commit real API keys, passwords, tokens, or production secrets.

APP_ENV=development
DEMO_MODE=false

MONGO_URL=mongodb://localhost:27017
DB_NAME=varuna_netra

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional live AIS integration
AISSTREAM_API_KEY=

# Optional demo-only users. Keep blank unless DEMO_MODE=true.
DEMO_SUPERVISOR_EMAIL=supervisor@example.com
DEMO_SUPERVISOR_PASSWORD=
DEMO_ANALYST_EMAIL=analyst@example.com
DEMO_ANALYST_PASSWORD=
